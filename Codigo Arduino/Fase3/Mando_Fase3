#include <ArduinoBLE.h>
#include <Arduino_LSM6DSOX.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ================= OLED =================
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// ================= PINES =================
#define PIN_D2 2
#define PIN_D3 3
#define PIN_D4 4

// ================= ACELERÓMETRO =================
float Ax, Ay, Az;

// ================= ESTADO =================
bool habManual = false;
int  caminoSel = 0;
bool ultimoD2  = HIGH;
bool ultimoD3  = HIGH;
bool ultimoD4  = HIGH;

// ================= PANTALLA =================
void mostrarBuscando() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("  == KUKI MANDO ==");
  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);
  display.setCursor(0, 18);
  display.println("Buscando AGV...");
  display.setCursor(0, 30);
  display.println("Asegurate de que");
  display.println("el KUKI este");
  display.println("encendido");
  display.display();
}

void mostrarConectado(int camino, bool manual, float vel, bool der, bool izq) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  // Cabecera
  display.setCursor(0, 0);
  display.println("  == KUKI MANDO ==");
  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  // Modo
  display.setCursor(0, 14);
  display.print("Modo: ");
  display.setTextSize(2);
  display.setCursor(40, 12);
  display.println(manual ? "MANUAL" : "AUTO");
  display.setTextSize(1);

  // Camino
  display.setCursor(0, 32);
  display.print("Camino: ");
  if      (camino == 0) display.println("--");
  else if (camino == 2) display.println("CORTO (2)");
  else if (camino == 3) display.println("LARGO (3)");

  // Velocidad
  display.setCursor(0, 43);
  display.print("Vel: ");
  display.print((int)vel);
  display.println("/255");

  // Giros (solo en manual)
  if (manual) {
    display.setCursor(0, 54);
    display.print("Giro: ");
    if      (der) display.println("DERECHA >>>");
    else if (izq) display.println("<<< IZQUIERDA");
    else          display.println("---");
  }

  display.display();
}

void mostrarDesconectado() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("  == KUKI MANDO ==");
  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);
  display.setCursor(0, 20);
  display.println("AGV desconectado");
  display.setCursor(0, 35);
  display.println("Reconectando...");
  display.display();
}

// ================= SETUP =================
void setup() {
  Serial.begin(9600);

  pinMode(PIN_D2, INPUT_PULLUP);
  pinMode(PIN_D3, INPUT_PULLUP);
  pinMode(PIN_D4, INPUT_PULLUP);

  // OLED
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED FALLO");
    while (1);
  }
  display.clearDisplay();
  display.display();

  if (!BLE.begin()) {
    Serial.println("BLE FALLO");
    while (1);
  }
  if (!IMU.begin()) {
    Serial.println("IMU FALLO");
    while (1);
  }

  mostrarBuscando();
  Serial.println("Mando KUKI listo, buscando KUKI AGV...");
  BLE.scanForUuid("19B10000-E8F2-537E-4F6C-D104768A1214");
}

// ================= LOOP =================
void loop() {
  BLEDevice peripheral = BLE.available();

  if (peripheral) {
    Serial.print("Encontrado: ");
    Serial.println(peripheral.localName());

    if (peripheral.localName().indexOf("Mando Kuki") >= 0) {
      BLE.stopScan();
      controlar(peripheral);
      mostrarDesconectado();
      BLE.scanForUuid("19B10000-E8F2-537E-4F6C-D104768A1214");
    }
  }
}

// ================= CONTROLAR =================
void controlar(BLEDevice peripheral) {
  if (!peripheral.connect()) {
    Serial.println("Fallo al conectar");
    return;
  }
  Serial.println("Conectado al KUKI AGV");

  if (!peripheral.discoverAttributes()) {
    Serial.println("Fallo descubriendo atributos");
    peripheral.disconnect();
    return;
  }

  BLECharacteristic charX   = peripheral.characteristic("19b10001-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charY   = peripheral.characteristic("19b10002-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charVel = peripheral.characteristic("19b10003-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charCam = peripheral.characteristic("19b10004-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charDer = peripheral.characteristic("19b10005-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charIzq = peripheral.characteristic("19b10006-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charHab = peripheral.characteristic("19b10007-e8f2-537e-4f6c-d104768a1214");

  if (!charX || !charY || !charVel || !charCam || !charDer || !charIzq || !charHab) {
    Serial.println("Faltan caracteristicas");
    peripheral.disconnect();
    return;
  }

  while (peripheral.connected()) {
    leerBotones();

    int   lectPot = analogRead(A1);
    float potVel  = ((float)lectPot / 1023.0f) * 255.0f;
    bool  der     = (habManual && digitalRead(PIN_D2) == LOW);
    bool  izq     = (habManual && digitalRead(PIN_D3) == LOW);

    lectura(charX, charY, charVel, charCam, charDer, charIzq, charHab);
    mostrarConectado(caminoSel, habManual, potVel, der, izq);

    delay(100);
  }

  Serial.println("Desconectado del KUKI AGV");
}

// ================= BOTONES =================
void leerBotones() {
  bool d2 = digitalRead(PIN_D2);
  bool d3 = digitalRead(PIN_D3);
  bool d4 = digitalRead(PIN_D4);

  if (d4 == LOW && ultimoD4 == HIGH) {
    habManual = !habManual;
    Serial.print("Manual: ");
    Serial.println(habManual ? "ON" : "OFF");
  }

  if (!habManual) {
    if (d2 == LOW && ultimoD2 == HIGH) {
      caminoSel = 2;
      Serial.println("Camino: CORTO (2)");
    }
    if (d3 == LOW && ultimoD3 == HIGH) {
      caminoSel = 3;
      Serial.println("Camino: LARGO (3)");
    }
  }

  ultimoD2 = d2;
  ultimoD3 = d3;
  ultimoD4 = d4;
}

// ================= LECTURA Y ENVÍO =================
void lectura(BLECharacteristic &charX, BLECharacteristic &charY,
             BLECharacteristic &charVel, BLECharacteristic &charCam,
             BLECharacteristic &charDer, BLECharacteristic &charIzq,
             BLECharacteristic &charHab) {

  float valX = 0.0f, valY = 0.0f;
  if (IMU.accelerationAvailable()) {
    IMU.readAcceleration(Ax, Ay, Az);
    if (habManual) { valX = Ax; valY = Ay; }
  }
  charX.writeValue((uint8_t*)&valX, 4);
  charY.writeValue((uint8_t*)&valY, 4);

  int lectPot = analogRead(A1);
  float potVel = ((float)lectPot / 1023.0f) * 255.0f;
  charVel.writeValue((uint8_t*)&potVel, 4);

  charCam.writeValue((uint8_t*)&caminoSel, 4);

  uint8_t der = (habManual && digitalRead(PIN_D2) == LOW) ? 1 : 0;
  uint8_t izq = (habManual && digitalRead(PIN_D3) == LOW) ? 1 : 0;
  charDer.writeValue(&der, 1);
  charIzq.writeValue(&izq, 1);

  uint8_t hab = habManual ? 1 : 0;
  charHab.writeValue(&hab, 1);

  Serial.print("Camino:"); Serial.print(caminoSel);
  Serial.print(" Hab:");   Serial.print(habManual);
  Serial.print(" Der:");   Serial.print(der);
  Serial.print(" Izq:");   Serial.println(izq);
}
