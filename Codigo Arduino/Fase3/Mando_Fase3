#include <ArduinoBLE.h>
#include <Arduino_LSM6DSOX.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ================= OLED =================
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET    -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// ================= PINES =================
#define PIN_D2 2
#define PIN_D3 3
#define PIN_D4 4
#define PIN_D5 5  // boton parada → camino 0

// ================= ACELERÓMETRO =================
float Ax, Ay, Az;

// ================= ESTADO =================
bool habManual  = false;
int  caminoSel  = 0;
bool sinFilo    = false;
bool paradaEmg  = false;

bool ultimoD2 = HIGH;
bool ultimoD3 = HIGH;
bool ultimoD4 = HIGH;
bool ultimoD5 = HIGH;

// ================= PANTALLAS =================
void mostrarBuscando() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("  == KUKI MANDO ==");
  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);
  display.setCursor(0, 18);
  display.println("Buscando AGV...");
  display.setCursor(0, 30);
  display.println("Asegurate de que");
  display.println("el KUKI este");
  display.println("encendido");
  display.display();
}

void mostrarConectado(int camino, bool manual, float vel, bool der, bool izq) {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 0);
  display.println("  == KUKI MANDO ==");
  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setCursor(0, 14);
  display.print("Modo: ");
  display.setTextSize(2);
  display.setCursor(40, 12);
  display.println(manual ? "MANUAL" : "AUTO");
  display.setTextSize(1);

  display.setCursor(0, 32);
  display.print("Camino: ");
  if      (camino == 0) display.println("--");
  else if (camino == 2) display.println("CORTO (2)");
  else if (camino == 3) display.println("LARGO (3)");

  display.setCursor(0, 43);
  display.print("Vel: ");
  display.print((int)vel);
  display.println("/255");

  if (manual) {
    display.setCursor(0, 54);
    display.print("Giro: ");
    if      (der) display.println("DERECHA >>>");
    else if (izq) display.println("<<< IZQUIERDA");
    else          display.println("---");
  }

  display.display();
}

