  display.display();
}

void actualizarPantalla(bool der, bool izq) {
  if (paradaEmg) {
    mostrarParada();
  } else if (sinFilo && !habManual) {
    mostrarSinFilo();
  } else if (habManual) {
    mostrarManual(der, izq);
  } else {
    switch (caminoSel) {
      case 0:  mostrarAutoEspera();        break;
      case 1:  mostrarDestinoAlcanzado();  break;
      case 2:
      case 3:  mostrarEnCamino(caminoSel); break;
      default: mostrarAutoEspera();        break;
    }
  }
}

// ================= BOTONES =================
void leerBotones(BLECharacteristic &charCaminoCmd) {
  bool d2 = digitalRead(PIN_DER);
  bool d3 = digitalRead(PIN_IZQ);
  bool d4 = digitalRead(PIN_MOD);
  bool d5 = digitalRead(PIN_STOP);

  // Toggle manual/auto
  if (d4 == LOW && prevD4 == HIGH) {
    habManual = !habManual;
    Serial.print("[BTN] Manual: ");
    Serial.println(habManual ? "ON" : "OFF");
  }

  if (!habManual) {
    if (d2 == LOW && prevD2 == HIGH) {
      uint8_t cmd = 2;
      charCaminoCmd.writeValue(&cmd, 1);
      Serial.println("[BTN] Camino 2");
    }
    if (d3 == LOW && prevD3 == HIGH) {
      uint8_t cmd = 3;
      charCaminoCmd.writeValue(&cmd, 1);
      Serial.println("[BTN] Camino 3");
    }
  }

  // Parada siempre disponible
  if (d5 == LOW && prevD5 == HIGH) {
    uint8_t cmd = 0;
    charCaminoCmd.writeValue(&cmd, 1);
    Serial.println("[BTN] Parada -> camino 0");
  }

  prevD2 = d2;
  prevD3 = d3;
  prevD4 = d4;
  prevD5 = d5;
}

// ================= ENVIAR =================
void enviar(BLECharacteristic &charX,   BLECharacteristic &charY,
            BLECharacteristic &charVel, BLECharacteristic &charDer,
            BLECharacteristic &charIzq, BLECharacteristic &charHab) {

  float valX = 0.0f, valY = 0.0f;
  if (IMU.accelerationAvailable()) {
    IMU.readAcceleration(Ax, Ay, Az);
    if (habManual) { valX = Ax; valY = Ay; }
  }

  charX.writeValue((uint8_t*)&valX, 4);
  charY.writeValue((uint8_t*)&valY, 4);
  charVel.writeValue((uint8_t*)&potVel, 4);

  uint8_t der = (habManual && digitalRead(PIN_DER)  == LOW) ? 1 : 0;
  uint8_t izq = (habManual && digitalRead(PIN_IZQ)  == LOW) ? 1 : 0;
  uint8_t hab = habManual ? 1 : 0;

  charDer.writeValue(&der, 1);
  charIzq.writeValue(&izq, 1);
  charHab.writeValue(&hab, 1);
}

// ================= CONTROLAR =================
void controlar(BLEDevice peripheral) {
  if (!peripheral.connect()) {
    Serial.println("[BLE] Fallo al conectar");
    return;
  }
  Serial.println("[BLE] Conectado al KUKI AGV");
  delay(500);

  if (!peripheral.discoverAttributes()) {
    Serial.println("[BLE] Fallo descubriendo atributos");
    peripheral.disconnect();
    return;
  }
  Serial.println("[BLE] Atributos descubiertos OK");

  BLECharacteristic charX    = peripheral.characteristic(UUID_X);
  BLECharacteristic charY    = peripheral.characteristic(UUID_Y);
  BLECharacteristic charVel  = peripheral.characteristic(UUID_VEL);
  BLECharacteristic charCam  = peripheral.characteristic(UUID_CAM);
  BLECharacteristic charCamC = peripheral.characteristic(UUID_CAMC);
  BLECharacteristic charDer  = peripheral.characteristic(UUID_DER);
  BLECharacteristic charIzq  = peripheral.characteristic(UUID_IZQ);
  BLECharacteristic charHab  = peripheral.characteristic(UUID_HAB);
  BLECharacteristic charFilo = peripheral.characteristic(UUID_FILO);
  BLECharacteristic charPar  = peripheral.characteristic(UUID_PAR);

  if (!charX   || !charY    || !charVel  || !charCam ||
      !charCamC || !charDer || !charIzq  || !charHab ||
      !charFilo || !charPar) {
    Serial.println("[BLE] Faltan caracteristicas");
    peripheral.disconnect();
    return;
  }
  Serial.println("[BLE] Todas las caracteristicas OK");

  charCam.subscribe();
  charFilo.subscribe();
  charPar.subscribe();

  while (peripheral.connected()) {
    // Leer pot una sola vez por ciclo
    potVel = ((float)analogRead(A1) / 1023.0f) * 255.0f;

    leerBotones(charCamC);

    // Notificaciones del AGV
    if (charFilo.valueUpdated()) {
      uint8_t val = 0;
      charFilo.readValue(&val, 1);
      sinFilo = (val == 1);
      Serial.print("[AGV] SinFilo: "); Serial.println(sinFilo);
    }
    if (charPar.valueUpdated()) {
      uint8_t val = 0;
      charPar.readValue(&val, 1);
      paradaEmg = (val == 1);
      Serial.print("[AGV] Parada: "); Serial.println(paradaEmg);
    }
    if (charCam.valueUpdated()) {
      uint8_t val = 0;
      charCam.readValue(&val, 1);
      caminoSel = val;
      Serial.print("[AGV] Camino: "); Serial.println(caminoSel);
    }

    bool der = (habManual && digitalRead(PIN_DER) == LOW);
    bool izq = (habManual && digitalRead(PIN_IZQ) == LOW);

    enviar(charX, charY, charVel, charDer, charIzq, charHab);
    actualizarPantalla(der, izq);

    delay(100);
  }

  Serial.println("[BLE] Desconectado del KUKI AGV");
}

// ================= SETUP =================
void setup() {
  Serial.begin(9600);
  while (!Serial && millis() < 3000);  // esperar monitor serie max 3s
  Serial.println("[SYS] Iniciando mando KUKI...");

  pinMode(PIN_DER,  INPUT_PULLUP);
  pinMode(PIN_IZQ,  INPUT_PULLUP);
  pinMode(PIN_MOD,  INPUT_PULLUP);
  pinMode(PIN_STOP, INPUT_PULLUP);

  Wire.begin();

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("[ERR] OLED FALLO");
    while (1);
  }
  Serial.println("[SYS] OLED OK");
  display.clearDisplay();
  display.display();

  if (!BLE.begin()) {
    Serial.println("[ERR] BLE FALLO");
    while (1);
  }
  Serial.println("[SYS] BLE OK");

  if (!IMU.begin()) {
    Serial.println("[ERR] IMU FALLO");
    while (1);
  }
  Serial.println("[SYS] IMU OK");

  mostrarBuscando();
  Serial.println("[SYS] Buscando KUKI AGV...");
  BLE.scanForUuid(UUID_SVC);
}

// ================= LOOP =================
void loop() {
  BLEDevice peripheral = BLE.available();

  if (peripheral) {
    Serial.print("[BLE] Encontrado: '");
    Serial.print(peripheral.localName());
    Serial.println("'");

    if (peripheral.localName().indexOf("Mando Kuki") >= 0) {
      BLE.stopScan();
      controlar(peripheral);
      mostrarDesconectado();
      BLE.scanForUuid(UUID_SVC);
    }
  }
}
