// ================= PINES =================
#define PIN_DER  2   // D2: giro derecha (manual) / camino 2 (auto)
#define PIN_IZQ  3   // D3: giro izquierda (manual) / camino 3 (auto)
#define PIN_MOD  4   // D4: toggle manual/auto
#define PIN_STOP 5   // D5: parada → camino 0

// ================= UUIDs BLE =================
#define UUID_SVC  "19b10000-e8f2-537e-4f6c-d104768a1214"
#define UUID_X    "19b10001-e8f2-537e-4f6c-d104768a1214"
#define UUID_Y    "19b10002-e8f2-537e-4f6c-d104768a1214"
#define UUID_VEL  "19b10003-e8f2-537e-4f6c-d104768a1214"
#define UUID_CAM  "19b10004-e8f2-537e-4f6c-d104768a1214"
#define UUID_CAMC "19b10009-e8f2-537e-4f6c-d104768a1214"
#define UUID_DER  "19b10005-e8f2-537e-4f6c-d104768a1214"
#define UUID_IZQ  "19b10006-e8f2-537e-4f6c-d104768a1214"
#define UUID_HAB  "19b10007-e8f2-537e-4f6c-d104768a1214"
#define UUID_FILO "19b10008-e8f2-537e-4f6c-d104768a1214"
#define UUID_PAR  "19b1000a-e8f2-537e-4f6c-d104768a1214"

// ================= ESTADO =================
bool  habManual = false;
int   caminoSel = 0;
bool  sinFilo   = false;
bool  paradaEmg = false;
float potVel    = 0.0f;
float Ax = 0, Ay = 0, Az = 0;

bool prevD2 = HIGH;
bool prevD3 = HIGH;
bool prevD4 = HIGH;
bool prevD5 = HIGH;

