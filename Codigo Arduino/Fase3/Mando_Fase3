// ================= SETUP =================
void setup() {
  Serial.begin(9600);

  pinMode(PIN_D2, INPUT_PULLUP);
  pinMode(PIN_D3, INPUT_PULLUP);
  pinMode(PIN_D4, INPUT_PULLUP);
  pinMode(PIN_D5, INPUT_PULLUP);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED FALLO");
    while (1);
  }
  display.clearDisplay();
  display.display();

  if (!BLE.begin()) {
    Serial.println("BLE FALLO");
    while (1);
  }
  if (!IMU.begin()) {
    Serial.println("IMU FALLO");
    while (1);
  }

  mostrarBuscando();
  Serial.println("Mando KUKI listo, buscando KUKI AGV...");
  BLE.scanForUuid("19B10000-E8F2-537E-4F6C-D104768A1214");
}

// ================= LOOP =================
void loop() {
  BLEDevice peripheral = BLE.available();

  if (peripheral) {
    Serial.print("Encontrado: ");
    Serial.println(peripheral.localName());

    if (peripheral.localName().indexOf("Mando Kuki") >= 0) {
      BLE.stopScan();
      controlar(peripheral);
      mostrarDesconectado();
      BLE.scanForUuid("19B10000-E8F2-537E-4F6C-D104768A1214");
    }
  }
}

// ================= CONTROLAR =================
void controlar(BLEDevice peripheral) {
  if (!peripheral.connect()) {
    Serial.println("Fallo al conectar");
    return;
  }
  Serial.println("Conectado al KUKI AGV");

  if (!peripheral.discoverAttributes()) {
    Serial.println("Fallo descubriendo atributos");
    peripheral.disconnect();
    return;
  }

  BLECharacteristic charX        = peripheral.characteristic("19b10001-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charY        = peripheral.characteristic("19b10002-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charVel      = peripheral.characteristic("19b10003-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charCamino   = peripheral.characteristic("19b10004-e8f2-537e-4f6c-d104768a1214");  // solo lectura/notify
  BLECharacteristic charCaminoCmd= peripheral.characteristic("19b10009-e8f2-537e-4f6c-d104768a1214");  // escritura camino
  BLECharacteristic charDer      = peripheral.characteristic("19b10005-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charIzq      = peripheral.characteristic("19b10006-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charHab      = peripheral.characteristic("19b10007-e8f2-537e-4f6c-d104768a1214");
  BLECharacteristic charSinFiloC = peripheral.characteristic("19b10008-e8f2-537e-4f6c-d104768a1214");  // notify sin filo
  BLECharacteristic charParadaC  = peripheral.characteristic("19b1000a-e8f2-537e-4f6c-d104768a1214");  // notify parada

  if (!charX || !charY || !charVel || !charCamino || !charCaminoCmd ||
      !charDer || !charIzq || !charHab || !charSinFiloC || !charParadaC) {
    Serial.println("Faltan caracteristicas");
    peripheral.disconnect();
    return;
  }

  // Suscribirse a notificaciones
  charCamino.subscribe();
  charSinFiloC.subscribe();
  charParadaC.subscribe();

  while (peripheral.connected()) {
    leerBotones(charCaminoCmd);

    // Leer notificaciones del RP2040
    if (charSinFiloC.valueUpdated()) {
      uint8_t val = 0;
      charSinFiloC.readValue(&val, 1);
      sinFilo = (val == 1);
      Serial.print("SinFilo: "); Serial.println(sinFilo);
    }
    if (charParadaC.valueUpdated()) {
      uint8_t val = 0;
      charParadaC.readValue(&val, 1);
      paradaEmg = (val == 1);
      Serial.print("Parada: "); Serial.println(paradaEmg);
    }
    if (charCamino.valueUpdated()) {
      uint8_t val = 0;
      charCamino.readValue(&val, 1);
      caminoSel = val;
      Serial.print("Camino actualizado: "); Serial.println(caminoSel);
    }

    int   lectPot = analogRead(A1);
    float potVel  = ((float)lectPot / 1023.0f) * 255.0f;
    bool  der     = (habManual && digitalRead(PIN_D2) == LOW);
    bool  izq     = (habManual && digitalRead(PIN_D3) == LOW);

    enviar(charX, charY, charVel, charDer, charIzq, charHab);

    // Pantalla: parada tiene prioridad sobre sin filo
    if (paradaEmg)       mostrarParada();
    else if (sinFilo)    mostrarSinFilo();
    else                 mostrarConectado(caminoSel, habManual, potVel, der, izq);

    delay(100);
  }

  Serial.println("Desconectado del KUKI AGV");
}

// ================= BOTONES =================
void leerBotones(BLECharacteristic &charCaminoCmd) {
  bool d2 = digitalRead(PIN_D2);
  bool d3 = digitalRead(PIN_D3);
  bool d4 = digitalRead(PIN_D4);
  bool d5 = digitalRead(PIN_D5);

  // D4: toggle manual/auto
  if (d4 == LOW && ultimoD4 == HIGH) {
    habManual = !habManual;
    Serial.print("Manual: ");
    Serial.println(habManual ? "ON" : "OFF");
  }

  if (!habManual) {
    // D2: camino 2 (corto)
    if (d2 == LOW && ultimoD2 == HIGH) {
      uint8_t cmd = 2;
      charCaminoCmd.writeValue(&cmd, 1);
      Serial.println("Camino cmd: 2");
    }
    // D3: camino 3 (largo)
    if (d3 == LOW && ultimoD3 == HIGH) {
      uint8_t cmd = 3;
      charCaminoCmd.writeValue(&cmd, 1);
      Serial.println("Camino cmd: 3");
    }
  }

  // D5: parada → camino 0
  if (d5 == LOW && ultimoD5 == HIGH) {
    uint8_t cmd = 0;
    charCaminoCmd.writeValue(&cmd, 1);
    Serial.println("Camino cmd: 0 (PARADA)");
  }

  ultimoD2 = d2;
  ultimoD3 = d3;
  ultimoD4 = d4;
  ultimoD5 = d5;
}

// ================= ENVIAR =================
void enviar(BLECharacteristic &charX, BLECharacteristic &charY,
            BLECharacteristic &charVel,
            BLECharacteristic &charDer, BLECharacteristic &charIzq,
            BLECharacteristic &charHab) {

  float valX = 0.0f, valY = 0.0f;
  if (IMU.accelerationAvailable()) {
    IMU.readAcceleration(Ax, Ay, Az);
    if (habManual) { valX = Ax; valY = Ay; }
  }
  charX.writeValue((uint8_t*)&valX, 4);
  charY.writeValue((uint8_t*)&valY, 4);

  int lectPot = analogRead(A1);
  float potVel = ((float)lectPot / 1023.0f) * 255.0f;
  charVel.writeValue((uint8_t*)&potVel, 4);

  uint8_t der = (habManual && digitalRead(PIN_D2) == LOW) ? 1 : 0;
  uint8_t izq = (habManual && digitalRead(PIN_D3) == LOW) ? 1 : 0;
  charDer.writeValue(&der, 1);
  charIzq.writeValue(&izq, 1);

  uint8_t hab = habManual ? 1 : 0;
  charHab.writeValue(&hab, 1);

  Serial.print("Camino:"); Serial.print(caminoSel);
  Serial.print(" Hab:");   Serial.print(habManual);
  Serial.print(" Der:");   Serial.print(der);
  Serial.print(" Izq:");   Serial.println(izq);
}
